generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  patient
  doctor
  institution_admin
}

enum InstitutionType {
  hospital
  clinic
}

model User {
  id            Int      @id @default(autoincrement())
  wallet        String   @unique
  name          String
  email         String
  role          UserRole
  institutionId Int?
  createdAt     DateTime @default(now())

  @@map("users")
}

model Institution {
  id              Int             @id @default(autoincrement())
  institutionId   Int             @unique
  name            String
  institutionType InstitutionType
  adminWallet     String
  createdAt       DateTime        @default(now())

  @@map("institutions")
}
